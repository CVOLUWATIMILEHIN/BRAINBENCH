# ============================================================================
# Brainbench Technology — Environment Configuration Example
# Copy this file to `.env.local` for local development.
# NEVER commit real API keys, tokens, or credentials to version control.
# ============================================================================

# Optional: Public canonical site URL used for SEO metadata & OpenGraph tags
VITE_PUBLIC_SITE_URL="https://brainbenchtech.vercel.app"

# ============================================================================
# DEMO REQUEST EMAIL NOTIFICATION CONFIGURATION (Server-Side Only)
# ============================================================================

# Required: Recipient email address that receives new Demo Request notifications
# (Set this to your official Brainbench Technology business email)
DEMO_NOTIFICATION_EMAIL=""

# Option A: Resend Email API (Recommended for cloud deployments)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Brainbench Demo System <notifications@bbtechng.com>"

# Option B: Standard SMTP Server (e.g., Google Workspace SMTP, Zoho, or cPanel Mail)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Brainbench Demo System <notifications@bbtechng.com>"

# ============================================================================
# ADMIN PORTAL CONFIGURATION (Server-Side Only)
# ============================================================================
ADMIN_EMAIL="olosundelouis@gmail.com"
ADMIN_ACCESS_CODE=""
